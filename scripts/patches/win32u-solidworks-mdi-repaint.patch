+static BOOL is_solidworks_mdi_client( HWND hwnd )
+{
+    static const WCHAR client_class[] = u"swMdiClient";
+    static const WCHAR caption[] = u"SOLIDWORKS Design Professional";
+    WCHAR buffer[ARRAY_SIZE(client_class)], title[64];
+    UNICODE_STRING name = {.Buffer = buffer, .MaximumLength = sizeof(buffer)};
+    HWND root;

+    if (!hwnd || !is_current_thread_window( hwnd ) ||
+        NtUserGetClassName( hwnd, FALSE, &name ) != ARRAY_SIZE(client_class) - 1 ||
+        memcmp( buffer, client_class, sizeof(buffer) - sizeof(WCHAR) )) return FALSE;
+    root = NtUserGetAncestor( hwnd, GA_ROOT );
+    return root && root != hwnd && NtUserInternalGetWindowText( root, title, ARRAY_SIZE(title) ) &&
+           !wcsncmp( title, caption, ARRAY_SIZE(caption) - 1 );
