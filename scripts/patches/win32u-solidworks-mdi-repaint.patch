+
+void repaint_solidworks_active_view( HWND client )
+{
+    static const WCHAR view_class[] = u"Afx:0000000140000000:2b:";
+    WCHAR buffer[128];
+    UNICODE_STRING name = {.Buffer = buffer, .MaximumLength = sizeof(buffer)};
+    HWND child, *views, viewport = 0;
+    ULONGLONG largest = 0;
+    unsigned int i;
+
+    NtUserKillSystemTimer( client, SYSTEM_TIMER_SOLIDWORKS_VIEW );
+    if (!is_solidworks_process() || !is_solidworks_mdi_client( client )) return;
+    child = (HWND)send_message( client, WM_MDIGETACTIVE, 0, 0 );
+    if (!child || !is_window_visible( child ) || !(views = list_windows( child, TRUE ))) return;
+    for (i = 0; views[i]; i++)
+    {
+        HWND view = views[i];
+        RECT rect;
+        ULONGLONG area;
+        if (!is_current_thread_window( view ) || !is_window_visible( view ) ||
+            NtUserGetClassName( view, FALSE, &name ) < ARRAY_SIZE(view_class) - 1 ||
+            memcmp( buffer, view_class, sizeof(view_class) - sizeof(WCHAR) ) ||
+            !get_client_rect( view, &rect, get_thread_dpi() ) || rect.right <= 0 || rect.bottom <= 100)
+            continue;
+        area = (ULONGLONG)rect.right * rect.bottom;
+        if (area <= largest) continue;
+        largest = area;
+        viewport = view;
+    }
+    free( views );
+    if (viewport)
+        NtUserRedrawWindow( viewport, NULL, 0, RDW_INVALIDATE | RDW_NOCHILDREN );
+}
+
 BOOL WINAPI NtUserDestroyWindow( HWND hwnd )
 {
-    return user_destroy_window( hwnd, TRUE );
+    HWND client = 0;
+    BOOL done;
+
+    if (is_solidworks_process() && (get_window_long( hwnd, GWL_EXSTYLE ) & WS_EX_MDICHILD))
+    {
+        HWND parent = get_parent( hwnd );
+        if (is_solidworks_mdi_client( parent )) client = parent;
+    }
+    done = user_destroy_window( hwnd, TRUE );
+    /* The next document's viewport is laid out again after the MDI switch. */
+    if (done && client && is_window( client ))
+        NtUserSetSystemTimer( client, SYSTEM_TIMER_SOLIDWORKS_VIEW, 100 );
+    return done;
 }

