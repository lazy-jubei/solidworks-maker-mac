+/* Native presentation: the GL view is shown directly, clipped to the window's visible region. */
+static void present_native(struct macdrv_client_surface *surface)
+{
+    HWND hwnd = surface->client.hwnd;
+    struct macdrv_win_data *data;
+    BOOL child = hwnd != NtUserGetAncestor(hwnd, GA_ROOT);
+
+    if (!(data = get_win_data(hwnd))) return;
+    if (data->client_view != surface->cocoa_view)
+    {
+        if (data->client_view) macdrv_set_view_hidden(data->client_view, TRUE);
+        data->client_view = surface->cocoa_view;
+        surface->hidden = -1;  /* the previous surface may have hidden us behind our back */
+    }
+    if (!child) client_surface_set_hidden(surface, 0);
+    release_win_data(data);
+
+    if (child) client_surface_sync_child(surface);
+}
