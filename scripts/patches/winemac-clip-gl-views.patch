From: SolidWorks Maker on Mac
Subject: winemac.drv: clip native GL views to their visible region

Adapted from the Altium-on-Wine kit's 0002-winemac-clip-client-surfaces.patch
(same author, LGPL-2.1-or-later). A child window's GL view is a Cocoa subview
above everything Win32 draws, so SOLIDWORKS' FeatureManager, command tabs and
task pane were hidden under the 3D view. The view is masked (CAShapeLayer) to
the child's visible region and hidden when nothing is visible.

SOLIDWORKS addition: the FeatureManager and task pane are siblings of the
view's ancestors and need not be WS_CLIPSIBLINGS, so every visible window
above the view or above one of its ancestors is also excluded.

This replaces copying each frame through GDI (SW_OPENGL_GDI=1, still
available): rotation is about twice as fast and nothing is read back.

--- a/dlls/winemac.drv/cocoa_window.m
+++ b/dlls/winemac.drv/cocoa_window.m
@@ -3944,6 +3944,49 @@
 }
 
 /***********************************************************************
+ *              macdrv_set_view_clip_rects
+ *
+ * Altium-on-Wine kit: clip a client-surface view to the visible part of its
+ * Win32 window (rects in Win32 coordinates relative to the view), so sibling
+ * windows above it (pop-out panels, other document views) aren't covered by
+ * the Metal layer. NULL rects removes the clip.
+ */
+void macdrv_set_view_clip_rects(macdrv_view v, const CGRect *rects, int count)
+{
+@autoreleasepool
+{
+    WineContentView* view = (WineContentView*)v;
+    CGMutablePathRef path = NULL;
+    int i;
+
+    if (rects)
+    {
+        path = CGPathCreateMutable();
+        for (i = 0; i < count; i++)
+            CGPathAddRect(path, NULL, cgrect_mac_from_win(rects[i]));
+    }
+
+    OnMainThreadAsync(^{
+        CALayer* layer = [view layer];
+        CAShapeLayer* mask = (CAShapeLayer*)layer.mask;
+
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        if (!path)
+            layer.mask = nil;
+        else
+        {
+            if (!mask) layer.mask = mask = [CAShapeLayer layer];
+            mask.contentsScale = layer.contentsScale;
+            mask.path = path;
+        }
+        [CATransaction commit];
+        if (path) CGPathRelease(path);
+    });
+}
+}
