+void Surface::fillResizeEdges(CommandStream& commands, id<MTLTexture> previous, MTLSize copied) {
+    const NSUInteger width = color_.width, height = color_.height;
+    if (!layer_ || color_.sampleCount != 1 || (copied.width == width && copied.height == height)) return;
+
+    if (!resizeEdgePipeline_) {
+        id<MTLLibrary> library = Device::get().utilityLibrary();
+        MTLRenderPipelineDescriptor* pipeline = [MTLRenderPipelineDescriptor new];
+        pipeline.vertexFunction = [library newFunctionWithName:@"wmgl_fullscreen_vs"];
+        pipeline.fragmentFunction = [library newFunctionWithName:@"wmgl_resize_edge_fs"];
+        pipeline.colorAttachments[0].pixelFormat = color_.pixelFormat;
+        NSError* error = nil;
+        resizeEdgePipeline_ = [Device::get().mtl() newRenderPipelineStateWithDescriptor:pipeline error:&error];
+        if (!resizeEdgePipeline_) {
+            WMGL_WARN(Surface, "resize edge pipeline: %s", error.localizedDescription.UTF8String);
+            return;
+        }
+    }
+
+    commands.endEncoder();
+    MTLRenderPassDescriptor* pass = [MTLRenderPassDescriptor renderPassDescriptor];
+    pass.colorAttachments[0].texture = color_;
+    pass.colorAttachments[0].loadAction = MTLLoadActionDontCare;
+    pass.colorAttachments[0].storeAction = MTLStoreActionStore;
+    id<MTLRenderCommandEncoder> encoder = [commands.commandBuffer() renderCommandEncoderWithDescriptor:pass];
+    [encoder setRenderPipelineState:resizeEdgePipeline_];
+    [encoder setFragmentTexture:previous atIndex:0];
+    const float params[4] = {};
+    [encoder setVertexBytes:params length:sizeof(params) atIndex:0];
+
+    if (copied.width < width) {
+        [encoder setScissorRect:MTLScissorRect{copied.width, 0, width - copied.width, height}];
+        [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    }
+    if (copied.height < height) {
+        [encoder setScissorRect:MTLScissorRect{0, copied.height, copied.width, height - copied.height}];
+        [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:3];
+    }
+    [encoder endEncoding];
+}
