+// Preserve texture pixel coordinates when extending a resized GL back buffer.
+fragment float4 wmgl_resize_edge_fs(FullscreenOut in [[stage_in]],
+                                   texture2d<float, access::read> previous [[texture(0)]]) {
+    const uint2 extent(previous.get_width(), previous.get_height());
+    const uint2 inset = min(extent / 4u, uint2(16u));
+    uint2 pixel = uint2(uint(in.position.x), uint(in.position.y));
+    if (pixel.x >= extent.x) pixel.x = extent.x - 1u - inset.x;
+    if (pixel.y >= extent.y) pixel.y = extent.y - 1u - inset.y;
+    return previous.read(pixel);
+}
