+/* Wine batching (SOLIDWORKS Maker on Mac): simple GL calls are recorded on the PE side and
+ * replayed by one unix call, instead of one PE/unix transition (two macOS syscalls) each. */
+struct wine_batch_entry
+{
+    UINT32 code;  /* unix_funcs code */
+    UINT32 size;  /* bytes including this header, multiple of 8; params follow */
+};
+
+struct wine_batch_execute_params
+{
+    TEB *teb;
+    const void *data;
+    UINT32 size;
+};
+
+#ifdef WINE_UNIX_LIB
 #define UNIX_CALL( func, params ) WINE_UNIX_CALL( unix_ ## func, params )
+#else
+extern NTSTATUS wine_batch_call( unsigned int code, void *params );
+#define UNIX_CALL( func, params ) wine_batch_call( unix_ ## func, params )
+#endif
 
 #endif /* __WINE_OPENGL32_UNIXLIB_H */
