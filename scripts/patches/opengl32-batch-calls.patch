+/* Replay GL calls recorded by the PE side, in order, on the calling thread. */
+static NTSTATUS wine_batch_execute( void *args )
+{
+    const struct wine_batch_execute_params *params = args;
+    const char *ptr = params->data, *end = ptr + params->size;
+
+    while (ptr < end)
+    {
+        const struct wine_batch_entry *entry = (const void *)ptr;
+        if (entry->code >= unix_wine_batch_execute || entry->size < sizeof(*entry)) return STATUS_INVALID_PARAMETER;
+        __wine_unix_call_funcs[entry->code]( (void *)(entry + 1) );
+        ptr += entry->size;
+    }
+    return STATUS_SUCCESS;
+}
