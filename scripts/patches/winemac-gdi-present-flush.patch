+/***********************************************************************
+ *              macdrv_flush_present_surface
+ *
+ * Show what a GDI-presented GL frame drew into the toplevel window surface now.
+ * Plain opaque surfaces only; shaped or layered ones keep win32u's flush.
+ */
+void macdrv_flush_present_surface(HWND toplevel)
+{
+    struct macdrv_window_surface *surface;
+    struct window_surface *found = NULL;
+    CGColorSpaceRef colorspace;
+    CGImageRef image;
+    RECT dirty;
+    int width, height;
+
+    pthread_mutex_lock(&present_surfaces_lock);
+    LIST_FOR_EACH_ENTRY(surface, &present_surfaces, struct macdrv_window_surface, present_entry)
+    {
+        if (surface->header.hwnd != toplevel) continue;
+        found = &surface->header;
+        window_surface_add_ref(found);
+        break;
+    }
+    pthread_mutex_unlock(&present_surfaces_lock);
+    if (!found) return;
+
+    surface = get_mac_surface(found);
+    width = found->rect.right - found->rect.left;
+    height = found->rect.bottom - found->rect.top;
+    pthread_mutex_lock(&found->mutex);
+    if (!found->shape_region && !found->alpha_mask && found->color_key == CLR_INVALID &&
+        found->alpha_bits == -1)
+    {
+        SetRect(&dirty, 0, 0, width, height);
+        if (intersect_rect(&dirty, &dirty, &found->bounds))
+        {
+            colorspace = CGColorSpaceCreateWithName(kCGColorSpaceSRGB);
+            image = CGImageCreate(width, height, 8, 32, width * 4, colorspace,
+                                  kCGImageAlphaNoneSkipFirst | kCGBitmapByteOrder32Little,
+                                  surface->provider, NULL, retina_on, kCGRenderingIntentDefault);
+            CGColorSpaceRelease(colorspace);
+            macdrv_window_set_color_image(surface->window, image, cgrect_from_rect(found->rect),
+                                          cgrect_from_rect(dirty));
+            CGImageRelease(image);
+            SetRect(&found->bounds, INT_MAX, INT_MAX, INT_MIN, INT_MIN);
+        }
+    }
+    pthread_mutex_unlock(&found->mutex);
+    window_surface_release(found);
 }
