+/* SW_OPENGL_GDI_FLUSH=0 restores waiting for win32u's throttled surface flush. */
+static BOOL present_flush_enabled(void)
+{
+    static int enabled = -1;
+    if (enabled == -1)
+    {
+        const char *value = getenv("SW_OPENGL_GDI_FLUSH");
+        enabled = !value || strcmp(value, "0");
+    }
+    return enabled;
+}
