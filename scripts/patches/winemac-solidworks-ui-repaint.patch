+/* ScrollWindowEx moves the controls and then invalidates the page. Copying
+ * the shared backing bitmap can duplicate controls from the previous frame
+ * while the options page is processing a burst of wheel events. */
+static BOOL macdrv_ScrollDC(HDC hdc, INT dx, INT dy, HRGN update)
+{
+    RECT rect;
+    HWND hwnd, root;
+    WCHAR title[96];
+    static const WCHAR prefix[] = u"System Options - ";
+
+    if (macdrv_solidworks_process && update && dy && !dx &&
+        (hwnd = NtUserWindowFromDC(hdc)) && (root = NtUserGetAncestor(hwnd, GA_ROOT)) && root != hwnd &&
+        NtUserInternalGetWindowText(root, title, ARRAY_SIZE(title)) &&
+        !wcsncmp(title, prefix, ARRAY_SIZE(prefix) - 1))
+    {
+        TRACE("invalidating scrolled options page %p dx %d dy %d\n", hwnd, dx, dy);
+        NtUserInvalidateRect(hwnd, NULL, TRUE);
+        return TRUE;
+    }
+
+    NtGdiGetAppClipBox(hdc, &rect);
+    return NtGdiBitBlt(hdc, rect.left, rect.top, rect.right - rect.left, rect.bottom - rect.top,
+                      hdc, rect.left - dx, rect.top - dy, SRCCOPY, 0, 0);
+}
