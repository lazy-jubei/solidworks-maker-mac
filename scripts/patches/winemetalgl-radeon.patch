+static void add_window_hole( HWND hwnd, HWND top_level, const RECT *clip,
+                             struct wmgl_window_placement *placement )
+{
+    struct wmgl_rect *hole;
+    RECT rect;
+
+    if (placement->hole_count == WMGL_MAX_HOLES || !IsWindowVisible( hwnd ) || is_tracked( hwnd ) ||
+        !GetWindowRect( hwnd, &rect )) return;
+    MapWindowPoints( HWND_DESKTOP, top_level, (POINT *)&rect, 2 );
+    if (!IntersectRect( &rect, &rect, clip )) return;
+    hole = &placement->holes[placement->hole_count++];
+    hole->x = rect.left;
+    hole->y = rect.top;
+    hole->width = rect.right - rect.left;
+    hole->height = rect.bottom - rect.top;
+}
+
+static BOOL CALLBACK init_sibling_clipping( INIT_ONCE *once, void *param, void **context )
+{
+    char value[2];
+    *(BOOL *)param = GetEnvironmentVariableA( "WINEMETALGL_CLIP_SIBLINGS", value, sizeof(value) ) == 1 &&
+                    value[0] == '1';
+    return TRUE;
+}
+
+/* Prefer Wine's computed system clipping to repeated sibling queries.
+ * The system region is in screen coordinates and excludes higher GDI panes. */
+static BOOL dc_clip_holes( HDC dc, HWND top_level, const RECT *clip,
+                           struct wmgl_window_placement *placement )
+{
+    char buffer[sizeof(RGNDATAHEADER) + WMGL_MAX_HOLES * sizeof(RECT)] __attribute__((aligned(8)));
+    RGNDATA *data = (RGNDATA *)buffer;
+    HRGN visible = CreateRectRgn( 0, 0, 0, 0 ), hidden = NULL;
+    POINT origin = {0};
+    BOOL ok = FALSE;
+    RECT *rect;
+    unsigned int i;
+
+    if (!visible || GetRandomRgn( dc, visible, 4 /* SYSRGN */ ) != 1) goto done;
+    MapWindowPoints( top_level, HWND_DESKTOP, &origin, 1 );
+    if (!OffsetRgn( visible, -origin.x, -origin.y )) goto done;
+    if (!(hidden = CreateRectRgnIndirect( clip ))) goto done;
+    if (!CombineRgn( hidden, hidden, visible, RGN_DIFF ) ||
+        !GetRegionData( hidden, sizeof(buffer), data )) goto done;
+    rect = (RECT *)data->Buffer;
+    for (i = 0; i < data->rdh.nCount; ++i)
+    {
+        struct wmgl_rect *hole = &placement->holes[placement->hole_count++];
+        hole->x = rect[i].left;
+        hole->y = rect[i].top;
+        hole->width = rect[i].right - rect[i].left;
+        hole->height = rect[i].bottom - rect[i].top;
+    }
+    ok = TRUE;
+done:
+    if (hidden) DeleteObject( hidden );
+    if (visible) DeleteObject( visible );
+    return ok;
+}
