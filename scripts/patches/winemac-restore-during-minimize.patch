     - (void)windowDidMiniaturize:(NSNotification *)notification
     {
         macdrv_event* event;
+        BOOL forWine = miniaturizingForWine;
+
+        miniaturizingForWine = FALSE;
+        /* Wine hid the window while that animation was running, so it was ordered out while not yet
+         * miniaturized and Cocoa still finished the minimize. Take it out of the Dock the way
+         * doOrderOut does for a minimized window, keeping the state Wine asked for. */
+        if (forWine && orderedOutForWine)
+        {
+            pendingMinimize = wineWantsMinimized;
+            fakingClose = TRUE;
+            [self close];
+            fakingClose = FALSE;
+            return;
+        }
+        /* Wine restored the window while the minimize animation it asked for was still running,
+         * when -isMiniaturized was not yet true, so the restore was skipped. Qt shows windows
+         * minimized and immediately restored. Undo it rather than reporting a minimize. */
+        if (forWine && !wineWantsMinimized)
+        {
+            ignore_windowDeminiaturize = TRUE;
+            [self deminiaturize:nil];
+            return;
+        }
 
         if (fullscreen && [self isOnActiveSpace])
             [[WineApplicationController sharedController] updateFullscreenWindows];
