--- a/dlls/winemac.drv/window.c
+++ b/dlls/winemac.drv/window.c
@@ -204,4 +204,16 @@
 }

+
+/* A surface flush already holds win32u's surface lock. Do not wait
+ * for a window operation that may need that lock to finish. */
+BOOL try_get_win_data(HWND hwnd, struct macdrv_win_data **data)
+{
+    *data = NULL;
+    if (!hwnd) return TRUE;
+    if (pthread_mutex_trylock(&win_data_mutex)) return FALSE;
+    if (win_datas) *data = (struct macdrv_win_data *)CFDictionaryGetValue(win_datas, hwnd);
+    if (!*data) pthread_mutex_unlock(&win_data_mutex);
+    return TRUE;
+}

