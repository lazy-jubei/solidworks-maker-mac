--- a/dlls/win32u/dce.c
+++ b/dlls/win32u/dce.c
@@ -678,6 +678,31 @@
               NtGetTickCount() - status_paint_started < STATUS_PAINT_LIMIT;
     pthread_mutex_unlock( &status_paint_lock );
     return pending;
+}
+
+/* The Options page scrolls its child HWNDs over a shared surface. Finish
+ * repainting the page before presenting any of the intermediate positions. */
+static HWND solidworks_options_scroll_root;
+
+static BOOL begin_solidworks_options_scroll( HWND hwnd )
+{
+    static const WCHAR title_prefix[] = u"System Options - ";
+    WCHAR buffer[ARRAY_SIZE(title_prefix)];
+    const WCHAR *image = RtlGetCurrentPeb()->ProcessParameters->ImagePathName.Buffer;
+    const WCHAR *basename;
+    HWND root, idle = 0;
+
+    if (!image) return FALSE;
+    basename = wcsrchr( image, '\\' );
+    if (wcsicmp( basename ? basename + 1 : image, u"sldworks.exe" )) return FALSE;
+    root = NtUserGetAncestor( hwnd, GA_ROOT );
+    if (!root || root == hwnd ||
+        NtUserInternalGetWindowText( root, buffer, ARRAY_SIZE(buffer) ) != ARRAY_SIZE(buffer) - 1 ||
+        memcmp( buffer, title_prefix, sizeof(buffer) - sizeof(WCHAR) ))
+        return FALSE;
+
+    return __atomic_compare_exchange_n( &solidworks_options_scroll_root, &idle, root, FALSE,
+                                        __ATOMIC_ACQ_REL, __ATOMIC_ACQUIRE );
 }

