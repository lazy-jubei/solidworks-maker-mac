+    - (void) performPendingTooltipOrder
+    {
+        void (^order)(void) = pendingTooltipOrder;
+        if (!order) return;
+        pendingTooltipOrder = nil;
+        order();
+        [order release];
+    }
+
+    - (void) orderTooltipBelow:(WineWindow*)prev orAbove:(WineWindow*)next
+    {
+        NSUInteger generation = ++tooltipOrderGeneration;
+        [pendingTooltipOrder release];
+        pendingTooltipOrder = [^{
+            [self orderBelow:prev orAbove:next activate:NO];
+        } copy];
+
+        /* A reused tooltip might not submit a new surface. Let it show even
+         * in that case, provided it has not been hidden in the meantime. */
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, 150 * NSEC_PER_MSEC), dispatch_get_main_queue(), ^{
+            if (tooltipOrderGeneration == generation) [self performPendingTooltipOrder];
+        });
+    }
+
     - (void) doOrderOut
     {
         WineApplicationController* controller = [WineApplicationController sharedController];
         BOOL wasVisible = [self isVisible];
         BOOL wasOnActiveSpace = [self isOnActiveSpace];
 
+        [pendingTooltipOrder release];
+        pendingTooltipOrder = nil;
         [self endWindowDragging];
         [controller windowWillOrderOut:self];
 
