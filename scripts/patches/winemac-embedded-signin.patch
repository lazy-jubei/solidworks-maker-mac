+void *macdrv_create_bitmap_layer(void *root, void *child, CGRect bounds)
+{
+    __block CAContext *context = nil;
+    OnMainThread(^{
+        CALayer *layer = [CALayer layer];
+        layer.bounds = cgrect_mac_from_win(bounds);
+        layer.anchorPoint = CGPointZero;
+        layer.position = CGPointZero;
+        layer.contentsGravity = kCAGravityResize;
+        layer.contentsScale = retina_on ? 2.0 : 1.0;
+        layer.magnificationFilter = kCAFilterNearest;
+        context = [[CAContext contextWithCGSConnection:CGSMainConnectionID()
+                                             options:[NSDictionary dictionary]] retain];
+        [context setLayer:layer];
+    });
+    if (context.contextId) macdrv_create_remote_layer(root, child, context.contextId);
+    else
+    {
+        [context release];
+        return NULL;
+    }
+    return context;
+}
+
+void macdrv_update_bitmap_layer(void *opaque, CGImageRef image)
+{
+    CAContext *context = [(CAContext *)opaque retain];
+    CGImageRetain(image);
+    OnMainThreadAsync(^{
+        [CATransaction begin];
+        [CATransaction setDisableActions:YES];
+        context.layer.contents = (id)image;
+        [CATransaction commit];
+        CGImageRelease(image);
+        [context release];
+    });
+}
+
+void macdrv_destroy_bitmap_layer(void *opaque, void *root)
+{
+    CAContext *context = (CAContext *)opaque;
+    macdrv_release_remote_layer(root, context.contextId);
+    OnMainThreadAsync(^{
+        [context setLayer:nil];
+        [context release];
+    });
+}
