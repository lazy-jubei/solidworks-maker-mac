  * Set the visible region and X11 drawable for the DC associated to
  * a given window.
  */
+/* Both fixtures' backing surfaces use top-down 32-bit DIBs. */
+static void copy_foreign_surface_pixels( struct window_surface *dst, struct window_surface *src )
+{
+    char src_buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    char dst_buffer[FIELD_OFFSET( BITMAPINFO, bmiColors[256] )];
+    BITMAPINFO *src_info = (BITMAPINFO *)src_buffer, *dst_info = (BITMAPINFO *)dst_buffer;
+    const BYTE *src_bits;
+    BYTE *dst_bits;
+    LONG y, width, height, src_stride, dst_stride;
+
+    /* The replacement isn't published yet. Only the old surface needs locking. */
+    window_surface_lock( src );
+    src_bits = window_surface_get_color( src, src_info );
+    dst_bits = window_surface_get_color( dst, dst_info );
+    if (src_bits && dst_bits && src_info->bmiHeader.biBitCount == 32 && dst_info->bmiHeader.biBitCount == 32 &&
+        src_info->bmiHeader.biHeight < 0 && dst_info->bmiHeader.biHeight < 0)
+    {
+        src_stride = src_info->bmiHeader.biWidth * 4;
+        dst_stride = dst_info->bmiHeader.biWidth * 4;
+        width = min( src_stride, dst_stride );
+        height = min( -src_info->bmiHeader.biHeight, -dst_info->bmiHeader.biHeight );
+        for (y = 0; y < height; y++)
+            memcpy( dst_bits + (size_t)y * dst_stride, src_bits + (size_t)y * src_stride, width );
+        dst->bounds = dst->rect;
+    }
+    window_surface_unlock( src );
+}
