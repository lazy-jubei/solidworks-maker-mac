+/* A SolidWorks MDI viewport may render during WM_PAINT using an owned DC.
+ * Its paint clip describes only the updated pixels, so using it for a
+ * persistent Metal layer mask can hide the already-rendered model. */
+static void refresh_mdi_occlusion( HWND hwnd, HWND root, HRGN visible, POINT center )
+{
+    HWND ancestor, parent;
+    HDC query_dc;
+    HRGN queried;
+    DWORD flags = DCX_CACHE, style;
+    WCHAR class_name[32];
+
+    if (PtInRegion( visible, center.x, center.y ) ||
+        !(GetClassLongW( hwnd, GCL_STYLE ) & (CS_OWNDC | CS_CLASSDC))) return;
+
+    for (ancestor = hwnd; ancestor && ancestor != root; ancestor = GetAncestor( ancestor, GA_PARENT ))
+    {
+        if (GetWindowLongW( ancestor, GWL_EXSTYLE ) & WS_EX_MDICHILD) break;
+    }
+    if (!ancestor || ancestor == root || !(parent = GetAncestor( ancestor, GA_PARENT )) ||
+        !GetClassNameW( parent, class_name, ARRAYSIZE(class_name) ) ||
+        lstrcmpiW( class_name, L"swMdiClient" )) return;
+
+    style = GetWindowLongW( hwnd, GWL_STYLE );
+    if (style & WS_CLIPSIBLINGS) flags |= DCX_CLIPSIBLINGS;
+    if ((style & (WS_CLIPCHILDREN | WS_MINIMIZE)) == WS_CLIPCHILDREN) flags |= DCX_CLIPCHILDREN;
+    if (!(query_dc = GetDCEx( hwnd, NULL, flags ))) return;
+    if ((queried = CreateRectRgn( 0, 0, 0, 0 )))
+    {
+        if (GetRandomRgn( query_dc, queried, 4 /* SYSRGN */ ) == 1 &&
+            PtInRegion( queried, center.x, center.y ))
+            CombineRgn( visible, queried, NULL, RGN_COPY );
+        DeleteObject( queried );
+    }
+    ReleaseDC( hwnd, query_dc );
 }

