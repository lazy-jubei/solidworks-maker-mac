+    - (void) tooltipSurfaceUpdated
+    {
+        if (!pendingTooltipOrder || tooltipPaintOrderScheduled) return;
+        if (!tooltipPaintSettleMs)
+        {
+            [self performPendingTooltipOrder];
+            return;
+        }
+
+        /* A SOLIDWORKS balloon can flush its background before its text.
+         * Let the later GDI update reach the view before ordering the window. */
+        tooltipPaintOrderScheduled = YES;
+        NSUInteger generation = tooltipOrderGeneration;
+        dispatch_after(dispatch_time(DISPATCH_TIME_NOW, tooltipPaintSettleMs * NSEC_PER_MSEC),
+                       dispatch_get_main_queue(), ^{
+            if (tooltipOrderGeneration == generation) [self performPendingTooltipOrder];
+        });
+    }
