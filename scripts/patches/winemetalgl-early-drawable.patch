+
+/* Some apps resize the full viewport while leaving the context current.
+ * Update the matching drawable before executing commands for that viewport. */
+static void sync_viewport_drawable( const struct glViewport_params *viewport )
+{
+    struct thread_state *state = thread_state( FALSE );
+    struct wmgl_place_window_params params = {0};
+    static LONG enabled;
+    LONG mode = InterlockedCompareExchange( &enabled, 0, 0 );
+    if (!mode)
+    {
+        WCHAR value[2];
+        mode = GetEnvironmentVariableW( L"SW_TEST_SYNC_VIEWPORT_DRAWABLE", value, ARRAYSIZE(value) ) == 1 &&
+               value[0] == '1' ? 1 : -1;
+        InterlockedCompareExchange( &enabled, mode, 0 );
+    }
+    if (mode < 0 || !state || !state->draw || viewport->x || viewport->y ||
+        viewport->width < 1 || viewport->height < 1 ||
+        (state->drawable_width == (UINT)viewport->width && state->drawable_height == (UINT)viewport->height))
+        return;
+    window_placement( state->draw, &params.window );
+    if (!params.window.hwnd || (UINT)params.window.width != (UINT)viewport->width ||
+        (UINT)params.window.height != (UINT)viewport->height) return;
+    params.resize_drawable = TRUE;
+    if (!wmgl_unix_call( unix_wmgl_place_window, &params ))
+    {
+        state->drawable_width = params.window.width;
+        state->drawable_height = params.window.height;
+    }
 }
 
 /* ------------------------------------------------------------ contexts */
