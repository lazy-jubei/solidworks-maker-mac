+/* Keep the foreign browser subtree on its owning thread during teardown. */
+static BOOL defer_solidworks_browser_destroy( HWND hwnd )
+{
+    static const WCHAR browser_class[] = u"Chrome_WidgetWin_1";
+    WCHAR buffer[ARRAY_SIZE(browser_class)];
+    UNICODE_STRING name = {.Buffer = buffer, .MaximumLength = sizeof(buffer)};
+    const WCHAR *image, *basename;
+    DWORD owner, pid;
+
+    owner = get_window_thread( hwnd, &pid );
+    if (!owner || owner == GetCurrentThreadId() || pid != GetCurrentProcessId()) return FALSE;
+
+    image = RtlGetCurrentPeb()->ProcessParameters->ImagePathName.Buffer;
+    if (!image) return FALSE;
+    basename = wcsrchr( image, '\\' );
+    if (wcsicmp( basename ? basename + 1 : image, u"sldworks.exe" )) return FALSE;
+
+    return NtUserGetClassName( hwnd, FALSE, &name ) == ARRAY_SIZE(browser_class) - 1 &&
+           !memcmp( buffer, browser_class, sizeof(buffer) - sizeof(WCHAR) );
+}
